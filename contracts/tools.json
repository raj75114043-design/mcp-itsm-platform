[
  {
    "name": "add_work_note",
    "server": "itsm",
    "scope": "itsm.write",
    "risk": "write",
    "input_schema": {
      "properties": {
        "incident_id": {
          "pattern": "^INC-\\d{5}$",
          "title": "Incident Id",
          "type": "string"
        },
        "note": {
          "maxLength": 4000,
          "minLength": 3,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "incident_id",
        "note"
      ],
      "title": "WorkNote",
      "type": "object"
    }
  },
  {
    "name": "create_incident",
    "server": "itsm",
    "scope": "itsm.write",
    "risk": "write",
    "input_schema": {
      "properties": {
        "title": {
          "maxLength": 160,
          "minLength": 5,
          "title": "Title",
          "type": "string"
        },
        "ci_id": {
          "description": "Configuration item id, e.g. payments-db",
          "pattern": "^[a-z0-9-]{3,40}$",
          "title": "Ci Id",
          "type": "string"
        },
        "priority": {
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4"
          ],
          "title": "Priority",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 10,
          "title": "Description",
          "type": "string"
        },
        "related_change": {
          "anyOf": [
            {
              "pattern": "^CHG-\\d{4}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Related Change"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repeat calls with the same key return the first result",
          "title": "Idempotency Key"
        }
      },
      "required": [
        "title",
        "ci_id",
        "priority",
        "description"
      ],
      "title": "CreateIncident",
      "type": "object"
    }
  },
