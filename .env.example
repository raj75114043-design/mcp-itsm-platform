DATABASE_URL=postgresql+psycopg://itsm:itsm@postgres:5432/itsm
# token=client:scopes;...  — stands in for OAuth access tokens. Replace in any shared environment.
MCP_TOKENS=agent-token=incident-commander:itsm.read,itsm.write,cmdb.read,kb.read,oncall.read,oncall.page,monitoring.read;readonly-token=ops-dashboard:itsm.read,cmdb.read,kb.read,oncall.read,monitoring.read;admin-token=sre-admin:*
# Chaos testing, e.g. FAULT_INJECTION=cmdb=0.2 makes 20% of CMDB calls fail
FAULT_INJECTION=
# Optional LLM summary writer (no tool access): GROQ_API_KEY=...
